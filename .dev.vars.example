# 複製成 .dev.vars（已在 .gitignore）供本機 `npm run pages:dev` / `npm run dev` 使用。
# 正式環境用 `npx wrangler pages secret put <NAME> --project-name learn-chparenting` 設定，不要寫進程式或 commit。
AUTH_SECRET=請用 `openssl rand -base64 32` 產生
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
