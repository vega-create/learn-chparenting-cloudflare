# Google Analytics 4（到 GA4 後台複製測量 ID）
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console 驗證碼（到 GSC 後台複製）
NEXT_PUBLIC_GSC_CODE=xxxxxxxxxxxxxxxx

# 網站網址
NEXT_PUBLIC_SITE_URL=https://learn.chparenting.com

# Resend（到 resend.com 建立 API Key）
RESEND_API_KEY=re_xxxxxxxxxxxx

# 只有跑 scripts/migrate-from-supabase.mjs（從舊 Supabase 匯出）才需要，搬完可刪
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# 登入與 D1 的 secrets 放 .dev.vars（見 .dev.vars.example），不放這裡
